# Copy these values into your local environment or a local .env file.
# Never commit a real API key.
MIDI2SCORE_LLM_ENABLED=true
MIDI2SCORE_LLM_PROVIDER=deepseek
MIDI2SCORE_LLM_MODEL=deepseek-v4.1-flash
MIDI2SCORE_LLM_BASE_URL=https://api.deepseek.com
MIDI2SCORE_LLM_API_KEY=replace-with-real-key
MIDI2SCORE_LLM_TEMPERATURE=0
MIDI2SCORE_LLM_TIMEOUT_SECONDS=120
MIDI2SCORE_LLM_MAX_TOKENS=4096
MIDI2SCORE_LLM_LOG_DIR=evidence/llm
