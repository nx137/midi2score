# Template only. The working local file is config/llm.local.env (gitignored).
# Never commit a real API key.
# Official DeepSeek API: https://api-docs.deepseek.com/
MIDI2SCORE_LLM_ENABLED=true
MIDI2SCORE_LLM_PROVIDER=deepseek
MIDI2SCORE_LLM_MODEL=deepseek-flash
MIDI2SCORE_LLM_BASE_URL=https://api.deepseek.com
MIDI2SCORE_LLM_API_KEY=REPLACE_WITH_YOUR_KEY
MIDI2SCORE_LLM_REASONING_EFFORT=high
MIDI2SCORE_LLM_DISABLE_RESPONSE_STORAGE=true
MIDI2SCORE_LLM_EXTRA_BODY_JSON={}
MIDI2SCORE_LLM_MAX_CONTEXT_CHARS=300000
MIDI2SCORE_LLM_MAX_RECENT_MESSAGES=8
MIDI2SCORE_LLM_MAX_DECISIONS=8
MIDI2SCORE_LLM_TEMPERATURE=0
MIDI2SCORE_LLM_TIMEOUT_SECONDS=300
MIDI2SCORE_LLM_MAX_TOKENS=65536
MIDI2SCORE_LLM_LOG_DIR=evidence/llm
